# ── LLM provider selection ────────────────────────────────────────────────
# Options: gemini | anthropic | none
LLM_PROVIDER=gemini

# ── Gemini (default, free tier via Google AI Studio) ──────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
# Gemini makes ONE batch request for all exceptions per pipeline run.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Anthropic (optional alternative) ─────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-3-5
